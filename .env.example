# ---- Environment ---------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
API_KEY=                      # set to require auth on protected endpoints
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_TRACING=false

# ---- Server --------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=*

# ---- LLM providers -------------------------------------------------------
# Order matters: the first healthy provider serves the request.
#
# NO API KEYS ARE REQUIRED. Ollama runs locally, is free, and keeps your
# data on your machine - the other providers are strictly optional upgrades.
# A provider with no API key is simply skipped, and if none are configured
# the pipeline still returns a catalog-driven design rather than failing.
LLM_PROVIDERS=ollama,openai,anthropic,ivis
DEFAULT_MODEL=llama3.1:8b

# Local Ollama (free, private, no data leaves the machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# IVIS gateway (optional)
IVIS_GATEWAY_API_KEY=
IVIS_GATEWAY_BASE_URL=
IVIS_MODEL=gemma2:2b

# ---- Generation ----------------------------------------------------------
# MAX_TOKENS is Ollama's num_predict. Keep it generous: the agent prompts ask
# for large JSON documents, and a truncated object is unrecoverable.
MAX_TOKENS=3072
TEMPERATURE=0.7
REQUEST_TIMEOUT=120
# Each extra round is a full re-generation, so it costs real latency on a
# local model. 2 is enough for the deterministic violations to converge.
MAX_REFLECTION_ROUNDS=2
MAX_CONCURRENT_LLM_CALLS=4

# ---- RAG -----------------------------------------------------------------
# EMBEDDING_BACKEND=auto uses sentence-transformers when installed and falls
# back to a deterministic hashing embedder otherwise. Hashing needs no
# download and no key, but its similarity scores are compressed and low
# (typically 0.15-0.30), which is expected rather than a misconfiguration.
#
# For noticeably better retrieval, free and keyless:
#   ./venv/bin/pip install sentence-transformers
#   EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_BACKEND=auto        # auto | sentence-transformers | hashing
EMBEDDING_MODEL=all-minilm-l6-v2
EMBEDDING_DIM=384
RAG_TOP_K=4
RAG_MIN_SCORE=0.15
RERANK_ENABLED=true

# ---- Semantic cache ------------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
# Keep this high. A false positive serves the wrong design, which is far
# worse than a cache miss. See README for the measured justification.
SEMANTIC_CACHE_THRESHOLD=0.9
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# ---- Security ------------------------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Observability -------------------------------------------------------
ENABLE_METRICS=true

# ---- Storage -------------------------------------------------------------
VECTOR_STORE_PATH=data/vector_store

# ---- Cloud deployment ----------------------------------------------------
# Streamlit Cloud, Render, and Vercel cannot access Ollama on your computer.
# Set ENVIRONMENT=production and LLM_PROVIDERS=openai,anthropic in the host's
# environment, then add OPENAI_API_KEY or ANTHROPIC_API_KEY as a host secret.
# Configure a hard spend limit and alert with the provider before deployment;
# provider-account limits cannot be set from this application.

# ---- Not wired up -------------------------------------------------------
# Photo upload, room analysis, and rendered redesign images need an external
# vision or image-generation API. Neither is implemented, so no key is
# required for anything in this project. The floor plan, Vastu scoring,
# pricing, and PDF proposal are all computed locally.
