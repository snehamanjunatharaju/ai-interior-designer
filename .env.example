# ---- Environment ---------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
API_KEY=                      # set to require auth on protected endpoints
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_TRACING=false

# ---- Server --------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=*

# ---- LLM providers -------------------------------------------------------
# Order matters: the first healthy provider serves the request.
LLM_PROVIDERS=ollama,openai,anthropic,ivis
DEFAULT_MODEL=gemma2:2b

# Local Ollama (free, private, no data leaves the machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# IVIS gateway (optional)
IVIS_GATEWAY_API_KEY=
IVIS_GATEWAY_BASE_URL=
IVIS_MODEL=gemma2:2b

# ---- Generation ----------------------------------------------------------
MAX_TOKENS=2048
TEMPERATURE=0.7
REQUEST_TIMEOUT=120
MAX_REFLECTION_ROUNDS=2
MAX_CONCURRENT_LLM_CALLS=4

# ---- RAG -----------------------------------------------------------------
EMBEDDING_BACKEND=auto        # auto | sentence-transformers | hashing
EMBEDDING_MODEL=all-minilm-l6-v2
EMBEDDING_DIM=384
RAG_TOP_K=4
RAG_MIN_SCORE=0.15
RERANK_ENABLED=true

# ---- Semantic cache ------------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
# Keep this high. A false positive serves the wrong design, which is far
# worse than a cache miss. See README for the measured justification.
SEMANTIC_CACHE_THRESHOLD=0.9
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# ---- Security ------------------------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Observability -------------------------------------------------------
ENABLE_METRICS=true

# ---- Storage -------------------------------------------------------------
VECTOR_STORE_PATH=data/vector_store
